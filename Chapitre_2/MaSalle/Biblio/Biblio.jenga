#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# Biblio - Jenga Project (inclus dans le workspace via include())

from Jenga import *

with project("Biblio"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    includedirs(["../Livre/include"])
    dependson(["Livre"])
    files(["src/**.cpp", "include/**.hpp"])
